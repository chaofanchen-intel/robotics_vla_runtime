# Python environments: copied from the benchmark repo on disk (see README.md); not in git
/envs

# Models: symlink to the benchmark repo's cache (see README.md)
/models

# Upstream source snapshots (recorded in external/README.md; not vendored into this repo)
/external/*
!/external/README.md

# Pinned runtime checkouts used by envs/ (recorded in pinned/README.md; not vendored into this repo)
/pinned/*
!/pinned/README.md

# Build outputs (rebuild with build/README.md)
/build/mstar_rust/
/build/mstar_rust_wheel/
/build/bin/

# Experiment outputs: kept locally only, not in git (see runs/README.md)
/runs/

# Decoded droid_100 frames (regenerated by src/runtime/dataset.py)
/data/

# Fixtures and images (large; copied from the benchmark repo on disk)
exps/inputs/*
!exps/inputs/README.md
exps/runs/

# Python and editor artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
