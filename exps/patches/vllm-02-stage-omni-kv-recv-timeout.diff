+# Keys that say which KV transfers a stage performs. They belong to the pipeline topology.
+_OMNI_KV_ROLE_KEYS = frozenset({"need_send_cache", "need_recv_cache", "kv_transfer_criteria"})
+
+
+def merge_omni_kv_config(deploy_value: Any, topology_value: Any) -> dict[str, Any] | None:
+    """Combine a deploy YAML stage ``omni_kv_config`` with the topology's.
+
+    The topology owns the KV roles (``_OMNI_KV_ROLE_KEYS``): a role the deploy YAML
+    names is ignored when the topology defines the transfer. The deploy YAML may add
+    tuning keys the topology does not set, such as ``recv_timeout``; without this,
+    a per-stage override silently has no effect.
+    """
+    deploy: dict[str, Any] = dict(deploy_value) if isinstance(deploy_value, Mapping) else {}
+    if not topology_value:
+        return deploy or None
+    merged = {key: value for key, value in deploy.items() if key not in _OMNI_KV_ROLE_KEYS}
+    merged.update(dict(topology_value))
+    return merged or None
+
+
 def _build_engine_args(
