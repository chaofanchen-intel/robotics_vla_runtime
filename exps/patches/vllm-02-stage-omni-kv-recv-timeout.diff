+++ b/tests/engine/test_stage_omni_kv_config.py
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+"""A stage-level ``omni_kv_config`` in the deploy YAML must reach the stage's KV manager.
+
+Before the fix, the topology's ``omni_kv_config`` replaced the YAML value outright, so
+``recv_timeout`` (and any other tuning key the topology does not set) was dropped in
+both the typed and the legacy config builders.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from vllm_omni.config.omni_config import VllmOmniConfig
+from vllm_omni.config.stage_config import merge_omni_kv_config
+from vllm_omni.distributed.omni_connectors.kv_transfer_manager import OmniKVTransferManager
+from vllm_omni.engine import stage_init_utils
+from vllm_omni.model_executor.models.bagel.pipeline import BAGEL_PIPELINE
+
+_DEPLOY_YAML = """
+async_chunk: false
+stages:
+  - stage_id: 0
+    max_num_seqs: 3
+    enable_prefix_caching: true
+    devices: "0"
+    output_connectors:
+      to_stage_1: kv_connector
+  - stage_id: 1
+    max_num_seqs: 1
+    enforce_eager: true
+    enable_prefix_caching: false
+    omni_kv_config:
+      need_recv_cache: true
+      recv_timeout: 900
+    devices: "1"
+    input_connectors:
+      from_stage_0: kv_connector
+connectors:
+  kv_connector:
+    name: SharedMemoryConnector
+"""
+
+
+def test_merge_keeps_deploy_tuning_keys_and_topology_roles():
+    assert merge_omni_kv_config({"need_recv_cache": True, "recv_timeout": 900}, {"need_recv_cache": True}) == {
+        "need_recv_cache": True,
+        "recv_timeout": 900,
+    }
+    assert merge_omni_kv_config(None, {"need_recv_cache": True}) == {"need_recv_cache": True}
+    assert merge_omni_kv_config({"recv_timeout": 900}, None) == {"recv_timeout": 900}
+    assert merge_omni_kv_config(None, None) is None
+    # the deploy YAML cannot add a KV role the topology does not define on its own
+    assert merge_omni_kv_config({"need_send_cache": True, "recv_timeout": 900}, {"need_recv_cache": True}) == {
+        "need_recv_cache": True,
+        "recv_timeout": 900,
+    }
+
+
+def test_stage_level_recv_timeout_reaches_diffusion_engine_args(tmp_path: Path):
+    deploy = tmp_path / "bagel_kv_timeout.yaml"
+    deploy.write_text(_DEPLOY_YAML, encoding="utf-8")
+    config = VllmOmniConfig.from_pipeline_config(BAGEL_PIPELINE, deploy_config_path=str(deploy))
+    stage = next(s for s in config.stage_configs if s.stage_id == 1)
+
+    engine_args = stage_init_utils.build_engine_args_dict_from_omni_stage_config(stage, "ByteDance-Seed/BAGEL-7B-MoT")
+
+    omni_kv = engine_args["omni_kv_config"]
+    assert omni_kv["recv_timeout"] == 900
+    assert omni_kv["need_recv_cache"] is True
+
+
+def test_kv_manager_reads_recv_timeout_from_omni_kv_config():
+    manager = OmniKVTransferManager._create({"need_recv_cache": True, "recv_timeout": 900})
+    assert manager.config.recv_timeout == 900
+    default = OmniKVTransferManager._create({"need_recv_cache": True})
+    assert default.config.recv_timeout == 30.0
