+#: (tile configuration) -> (block_k, num_stages) that fits this GPU's shared memory; see ``cp_linear``
+_CP_SMEM_FIT: dict[tuple, tuple[int, int]] = {}
+
+
 @torch.compiler.disable
 def cp_linear(
     x: torch.Tensor, w: torch.Tensor, *, out: torch.Tensor | None = None,
@@ -364,16 +369,35 @@ def cp_linear(
     assert rows <= _MAX_ROWS and n % block_n == 0 and k % block_k == 0 and w.stride(1) == 1 and x.stride(1) == 1
